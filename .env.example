# Turso database (required in production; without it, local dev uses ./data/store.json)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Pairing codes, one per partner. Generate with: node scripts/generate-pairing-codes.js
PARTNER1_CODE=
PARTNER2_CODE=

# IANA timezone whose midnight starts a new daily question (defaults to America/Santiago)
COUPLE_TIMEZONE=America/Santiago
